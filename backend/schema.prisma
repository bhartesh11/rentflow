// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  role          Role      @default(OWNER)
  name          String?
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenants       Tenant[]
  properties    Property[]
  requests      Request[]
}

enum Role {
  OWNER
  TENANT
}

model Property {
  id          String    @id @default(cuid())
  name        String
  address     String
  city        String
  state       String
  pincode     String
  description String?
  status      PropertyStatus @default(ACTIVE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  rooms       Room[]
  owner       User      @relation(fields: [ownerId], references: [id])
  ownerId     String
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

model Room {
  id              String    @id @default(cuid())
  roomNumber      String
  floor           String?
  rentAmount      Float
  depositAmount   Float?
  capacity        Int
  occupancyStatus RoomOccupancyStatus @default(VACANT)
  notes           String?
  images          String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  property        Property  @relation(fields: [propertyId], references: [id])
  propertyId      String
  tenant          Tenant?   @relation("RoomOccupancy", fields: [tenantId], references: [id])
  tenantId        String?
  assignedTenants Tenant[]  @relation("TenantAssignment")
  bills           Bill[]
  meterReadings   MeterReading[]
}

enum RoomOccupancyStatus {
  VACANT
  OCCUPIED
}

model Tenant {
  id              String    @id @default(cuid())
  fullName        String
  photo           String?
  mobileNumber    String
  email           String
  address         String?
  aadhaarNumber   String?
  pan             String?
  kycDocuments    String[]  @default([])
  emergencyContact String?
  occupation      String?
  joiningDate     DateTime?
  occupantsCount  Int       @default(1)
  securityDeposit Float?
  idProofType     IdProofType?
  idProofNumber   String?
  idProofDocument String?
  status          TenantStatus @default(PENDING)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User?     @relation(fields: [userId], references: [id])
  userId          String?
  assignedRoom    Room?     @relation("TenantAssignment", fields: [assignedRoomId], references: [id])
  assignedRoomId  String?
  occupiedRooms   Room[]    @relation("RoomOccupancy")
  bills           Bill[]
  payments        Payment[]
  requests        Request[]
}

enum TenantStatus {
  ACTIVE
  VACATED
  PENDING
}

enum IdProofType {
  AADHAAR
  PAN
  PASSPORT
  VOTER_ID
  DRIVING_LICENSE
}

model Bill {
  id              String    @id @default(cuid())
  invoiceNumber   String    @unique
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  tenantId        String
  room            Room      @relation(fields: [roomId], references: [id])
  roomId          String
  billingMonth    DateTime
  rent            Float
  electricityCharges Float?
  waterCharges    Float?
  maintenance     Float?
  otherCharges    Float?
  discounts       Float?
  previousDue     Float?
  totalAmount     Float
  dueDate         DateTime
  paymentStatus   PaymentStatus @default(PENDING)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  items           BillItem[]
  payments        Payment[]
  meterReading    MeterReading? @relation(fields: [meterReadingId], references: [id])
  meterReadingId  String?   @unique
}

model BillItem {
  id          String    @id @default(cuid())
  bill        Bill      @relation(fields: [billId], references: [id])
  billId      String
  description String
  amount      Float
  createdAt   DateTime  @default(now())
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
}

model MeterReading {
  id              String    @id @default(cuid())
  room            Room      @relation(fields: [roomId], references: [id])
  roomId          String
  previousReading Float
  currentReading  Float
  unitsConsumed   Float
  ratePerUnit     Float
  amount          Float
  readingMonth    DateTime
  billed          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bill            Bill?
}

model Payment {
  id            String    @id @default(cuid())
  amount        Float
  paymentMethod PaymentMethod
  paymentDate   DateTime  @default(now())
  balance       Float?
  notes         String?
  bill          Bill?     @relation(fields: [billId], references: [id])
  billId        String?
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  tenantId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  receipt       Receipt?
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
}

model Receipt {
  id            String    @id @default(cuid())
  receiptNumber String    @unique
  payment       Payment   @relation(fields: [paymentId], references: [id])
  paymentId     String    @unique
  amountPaid    Float
  balanceRemaining Float
  paymentDate   DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Request {
  id            String    @id @default(cuid())
  title         String
  description   String
  status        RequestStatus @default(PENDING)
  priority      RequestPriority @default(MEDIUM)
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  tenantId      String?
  user          User?     @relation(fields: [userId], references: [id])
  userId        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}